# 服务端口
PORT=3000

# 微信公众号账号配置（JSON 数组，支持多个账号）
# WECHAT_ACCOUNTS=[{"name":"我的公众号","appId":"wx...","appSecret":"..."}]
WECHAT_ACCOUNTS=

# Upstash Redis（可选，用于模板同步）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SQLite 数据库路径（默认 ./data.db）
DATABASE_PATH=./data.db

# Chrome 插件专用只读凭证（可选）
# 配了之后插件带 X-Extension-Key 头即可调用 /api/recommend、/api/recommend-html、
# /api/accounts 三个只读路由，不必存账号密码。不配则该通道关闭。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_API_KEY=
